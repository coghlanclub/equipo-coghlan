{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/profesor.html"
    },
    {
      "source": "/profe",
      "destination": "/profesor.html"
    },
    {
      "source": "/qr",
      "destination": "/tablet.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        }
      ]
    }
  ]
}
